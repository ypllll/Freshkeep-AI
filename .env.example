# 复制本文件为 .env 并按需修改。.env 已被 .gitignore 排除，不要提交真实密钥。

# SQLite 数据库文件路径（相对项目根目录）
DATABASE_PATH=data/freshkeep.db

# 注意：DUE_SOON_DAYS 是固定业务常量（2 天），按 docs/architecture.md 第 10 节不提供配置项，
# 因此这里不列出，也无法通过环境变量覆盖。

# ---- AI 模型（阶段 4）----
# 全部留空也能正常启动应用；只有实际调用模型时才会提示缺少配置。
# 下面的值都是占位示例，请替换成你自己的服务信息；不要提交真实密钥。
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://your-compatible-api-endpoint.example/v1
OPENAI_MODEL=your-model-name

# 单次请求超时秒数（可选，默认 30；非法值会回退到默认）
AI_TIMEOUT_SECONDS=30
